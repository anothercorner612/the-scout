# Copy this file to secrets.toml and fill in your values.
# On Streamlit Cloud, configure these in the app settings > Secrets.

gemini_key = "your_gemini_api_key_here"

# Used to sign session cookies — set to a long random string, keep it secret.
SESSION_SECRET = "your_random_session_secret_here"

# Turso cloud database
TURSO_URL = "libsql://the-scout-YOUR_ORG.turso.io"
TURSO_AUTH_TOKEN = "your_turso_auth_token_here"
